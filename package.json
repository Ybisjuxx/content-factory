{
  "name": "content-factory",
  "version": "1.3.0",
  "description": "100% Local Autonomous Video Factory with Motion Graphics, Remotion & OpenCut Studio",
  "main": "run_server.py",
  "scripts": {
    "start": "python run_server.py",
    "build:css": "tailwindcss -i web/src/tailwind.css -o web/vendor/tailwind.css --minify",
    "watch:css": "tailwindcss -i web/src/tailwind.css -o web/vendor/tailwind.css --watch"
  },
  "keywords": [
    "video-factory",
    "remotion",
    "motion-graphics"
  ],
  "author": "Ybis",
  "license": "MIT",
  "dependencies": {
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "lottie-web": "^5.13.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
